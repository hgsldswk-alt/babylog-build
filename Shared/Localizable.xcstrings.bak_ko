    "pay.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock adding baby profiles. Keep logging, viewing, sharing and exporting existing profiles. No automatic charges."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁新增宝宝档案。现有档案可继续记录、回看、交班及导出。不会自动扣费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解鎖新增寶寶檔案。現有檔案可繼續記錄、查看、交班及匯出。不會自動扣款。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "赤ちゃんのプロフィールの追加を解放します。既存のプロフィールの記録・閲覧・共有・書き出しはそのまま使えます。自動課金はありません。"
          }
        }
      }
    },
