    "error.amount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter an amount above 0 with up to 3 decimal places."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入大于 0、最多 3 位小数的奶量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入大於 0、最多 3 位小數的奶量。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0より大きい量を、小数点以下3桁までで入力してください。"
          }
        }
      }
    },
    "error.code": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid code. Paste the complete code with its unit and 3 to 6 amounts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "口令无效。请粘贴包含单位和 3 至 6 项奶量的完整口令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "口令無效。請貼上包含單位和 3 至 6 項奶量的完整口令。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効なコードです。単位と3〜6個の量を含むコード全体を貼り付けてください。"
          }
        }
      }
    },
    "error.codeFile": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t read the code file. Choose a text file containing a preset code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取口令文件。请选择含有奶量口令的文本文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取口令檔。請選擇含有奶量口令的文字檔。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードファイルを読み込めませんでした。プリセットコードの入ったテキストファイルを選んでください。"
          }
        }
      }
    },
