    "presets.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unit changes apply to new records. Set 3 to 6 quick amounts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改单位只影响新记录。可设置 3 至 6 个快捷量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "修改單位只影響新記錄。可設定 3 至 6 個快捷量。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単位の変更は新しい記録から反映されます。よく使う量を3〜6個設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단위 변경은 새 기록부터 적용됩니다. 빠른 입력 양을 3–6개 정하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einheitenänderungen gelten für neue Einträge. Lege 3 bis 6 Schnellmengen fest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios de unidad se aplican a registros nuevos. Define de 3 a 6 cantidades rápidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le changement d’unité s’applique aux nouveaux relevés. Définis 3 à 6 quantités rapides."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A mudança de unidade vale para novos registros. Defina de 3 a 6 quantidades rápidas."
          }
        }
      }
    },
