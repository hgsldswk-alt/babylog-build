    "error.amount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter an amount above 0 with up to 3 decimal places."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入大于 0、最多 3 位小数的奶量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入大於 0、最多 3 位小數的奶量。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0より大きい量を、小数点以下3桁までで入力してください。"
