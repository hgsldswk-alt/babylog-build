    "pay.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock adding baby profiles. Keep logging, viewing, sharing and exporting existing profiles. No automatic charges."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁新增宝宝档案。现有档案可继续记录、回看、交班及导出。不会自动扣费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解鎖新增寶寶檔案。現有檔案可繼續記錄、查看、交班及匯出。不會自動扣款。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "赤ちゃんのプロフィールの追加を解放します。既存のプロフィールの記録・閲覧・共有・書き出しはそのまま使えます。自動課金はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아기 프로필 추가를 잠금 해제합니다. 기존 프로필의 기록, 보기, 공유, 내보내기는 계속 쓸 수 있습니다. 자동 결제는 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte weitere Babyprofile frei. Eintragen, Ansehen, Teilen und Exportieren bestehender Profile bleibt möglich. Keine automatischen Abbuchungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea agregar perfiles de bebé. Puedes seguir registrando, viendo, compartiendo y exportando los perfiles existentes. Sin cobros automáticos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débloque l’ajout de profils bébé. Continue de noter, consulter, partager et exporter les profils existants. Aucun paiement automatique."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie a criação de perfis de bebê. Continue registrando, vendo, compartilhando e exportando os perfis existentes. Sem cobranças automáticas."
          }
        }
      }
    },
    "pay.expired": {
