        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine Menge über 0 mit höchstens 3 Nachkommastellen ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe una cantidad mayor que 0 con hasta 3 decimales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisis une quantité supérieure à 0 avec 3 décimales au plus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite uma quantidade acima de 0 com até 3 casas decimais."
          }
        }
      }
    },
    "error.code": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid code. Paste the complete code with its unit and 3 to 6 amounts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "口令无效。请粘贴包含单位和 3 至 6 项奶量的完整口令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "口令無效。請貼上包含單位和 3 至 6 項奶量的完整口令。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効なコードです。単位と3〜6個の量を含むコード全体を貼り付けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드가 올바르지 않습니다. 단위와 양 3–6개가 들어 있는 코드 전체를 붙여 넣으세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültiger Code. Füge den vollständigen Code mit Einheit und 3 bis 6 Mengen ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código no válido. Pega el código completo con su unidad y de 3 a 6 cantidades."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Code non valide. Colle le code complet avec son unité et 3 à 6 quantités."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Código inválido. Cole o código completo com a unidade e 3 a 6 quantidades."
          }
        }
      }
    },
